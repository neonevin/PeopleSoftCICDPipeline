@Library("test-lib") _
def uname
def pwd
def strComment
def dtt_phi_rsp=[:]
def dtt_phi_callbk=[:]
def callBackURLIndex
def boolean skipTest
def boolean skipMigr

pipeline {
    agent any
    stages {
        stage('Initialize') {
            steps {
                echo 'Initializing...'
                withCredentials([usernamePassword(credentialsId: 'phire_api_cred_dev03', usernameVariable: 'USERNAME', passwordVariable: 'USERPASS')]){
                    script{
                        uname = env.USERNAME
                        pwd = env.USERPASS
                        callBackURLIndex = UUID.randomUUID().toString()
                        skipTest = true
                        skipMigr = true
                    }
                }
            }
        }
        stage('Send Phire Request'){
            steps {
                echo 'Sending request to Phire...'
                script{
                    try{
                        echo" API URL: ${env.PHIRE_CR_API_DEV03}"
                        dtt_phi_rsp=PhireRequest(uname, pwd, PHIRE_NUM, TICKET_PROJECT, APP, CR_TYPE, TICKET_STATUS, ISSUE_ASSIGNEE, ISSUE_ASSIGNEE_EMAIL, 'S', TICKET_ID, LAST_COMMENT_BODY, SUMMARY, REQUEST_USER, REQUEST_USER_EMAIL, env.PHIRE_CR_API_DEV03,EXEC_TEST,TEST_CASE,callBackURLIndex) 
                        if (dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_ACTION_TYPE == 'MIGR' && dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.PHI_HAS_ERROR == false){
                            skipMigr = false
                        }
                    }catch(Exception e){
                        echo "in catch block : ${e.toString()}"                     }
                }
            }
        }
        stage('Migrate') {
            //if (dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_ACTION_TYPE == 'MIGR' && dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.PHI_HAS_ERROR == false){
            if (skipMigr){
                echo 'No migration as per Phire response, skipping migration and test stages...'
                Utils.markStageSkippedForConditional('Migrate')
                return
            }
            steps {
                echo 'Commencing stage -  Migrate change...'
                script {
                    //if (dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_ACTION_TYPE == 'MIGR' && dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.PHI_HAS_ERROR == false){
                        // send status to Jira
                    strComment=dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_PHI_RESP_TEXT
                    // add comment to Jira with response from Phire - (usually 'Migratoin queued')
                    jiraAddComment comment: strComment, idOrKey: JIRA_ISSUE_KEY, site: 'JIRACloud'
                    // wait for migration status update via call back from phire
                    //hook = registerWebhook(token: "migration_status")
                    hook = registerWebhook(callBackURLIndex)
                    echo "Waiting for POST to ${hook.url}"
                    def data = waitForWebhook hook
                    echo "Webhook called with data: ${data}"
                    // process request - add comment to Jira 
                    dtt_phi_callbk=PhireCallBackReq(data)
                    echo "call bk msg  ${dtt_phi_callbk.PHI_CALLBACK_REQ.PHI_ACTION_DESCR}"
                    echo "call bk msg  ${dtt_phi_callbk.PHI_CALLBACK_REQ}"
                    strComment = dtt_phi_callbk.PHI_CALLBACK_REQ.PHI_ACTION_DESCR
                    if (dtt_phi_callbk.PHI_CALLBACK_REQ.DTTL_TEST_STATUS == 'Pending'){
                        skipTest = false
                        // process test response and add comment to Jira
                        strComment = "${strComment} - Commencing execution of test case(s)"
                    } else{
                        strComment = "${strComment} - No test case(s) identified for execution or Test execution is disabled"
                    }
                    jiraAddComment comment: strComment, idOrKey: JIRA_ISSUE_KEY, site: 'JIRACloud'
                    //}
                }
            }
        }
        stage('Test') {
            //if (dtt_phi_callbk.PHI_CALLBACK_REQ.DTTL_TEST_STATUS == 'Pending'){
            if (skipTest){
                echo 'No test execution as per Phire response, skipping test execution stage...'
                Utils.markStageSkippedForConditional('Test')
                return
            }
            steps {
                echo 'Commencing stage - Test...'
                hook = registerWebhook(callBackURLIndex)
                echo "Waiting for POST to ${hook.url}"
                def data = waitForWebhook hook
                echo "Webhook called with data: ${data}"
                // process call back request - add comment to Jira
                dtt_phi_callbk=PhireCallBackReq(data)
                 if (dtt_phi_callbk.PHI_CALLBACK_REQ.DTTL_TEST_STATUS == 'Completed'){
                    strComment = dtt_phi_callbk.PHI_CALLBACK_REQ.PHI_ACTION_DESCR
                    jiraAddComment comment: strComment, idOrKey: JIRA_ISSUE_KEY, site: 'JIRACloud'
                }
            }
        }
        stage('update status'){
            steps{
                echo 'update status...'
                // if Phire Cr created
                if (dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_ACTION_TYPE =="CRTE" && dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.PHI_HAS_ERROR == false) {
                    testIssue.fields.customfield_10044=dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.PHI_CR_NUM
                    response = jiraEditIssue idOrKey: TICKET_ID, issue: testIssue, site: 'JIRACloud'
                    strComment=dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_PHI_RESP_TEXT  
                    echo response.successful.toString()
                    echo response.data.toString()
                    echo "testIssue Map: ${testIssue}"
                }
                if (dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_ACTION_TYPE !="MIGR" ) {
                    strComment=dtt_phi_rsp.CR_TASK_NEXT_STEP_RSP.DTTL_PHI_RESP_TEXT
                    jiraAddComment comment: strComment, idOrKey: JIRA_ISSUE_KEY, site: 'JIRACloud'
                }
            }
        }

    }
}
