                        testIssue.fields.customfield_10044=dtt_phi_rsp.PHI_CR_NUM
                        response = jiraEditIssue idOrKey: TICKET_ID, issue: testIssue, site: 'JIRACloud'
                        echo response.successful.toString()
                        echo response.data.toString()   
